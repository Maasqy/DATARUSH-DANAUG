# Copia este archivo a ".env" (en la misma carpeta) y coloca tu clave real.
# ".env" ya esta en .gitignore -- nunca subas tu clave real al repositorio.

# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Se usa SOLO del lado del servidor (dentro del proceso de Streamlit,
# en gemini_service.py) -- nunca llega al navegador ni al frontend.
GEMINI_API_KEY=

# Opcional: modelo de Gemini a usar para el analisis del dashboard.
GEMINI_MODEL=gemini-3.6-flash
